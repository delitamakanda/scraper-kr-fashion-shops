# Template for local (non-Docker) development.
# Copy to .env and adapt the values. Every variable read by the code is listed here.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# OpenWeatherMap API
OPENWEATHERMAP_APIKEY=

# Monitoring: use TCP checks only
MONITORING_USE_TCP_ONLY=False

# Selenium: leave empty to use a local Chrome, or set a remote WebDriver URL
SELENIUM_REMOTE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0
