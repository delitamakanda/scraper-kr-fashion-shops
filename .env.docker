# Variables injected into the `web` service by docker-compose.yml (env_file).
# Hostnames (redis, selenium) are the compose service names.

SECRET_KEY=<DANGO_SECRET_KEY>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

OPENWEATHERMAP_APIKEY=
MONITORING_USE_TCP_ONLY=False

SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub
REDIS_URL=redis://redis:6379/0
